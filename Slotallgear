local fileName = "MultiTool_Config.json"

local function saveConfig()
	if writefile then
		local saveData = {
			isLocked = isLocked,
			menuWidth = menuWidth,
			menuHeight = menuHeight,
			buttons = {}
		}
		for i, btn in ipairs(buttonsData) do
			table.insert(saveData.buttons, {
				id = btn.id,
				enabled = btn.enabled,
				size = btn.size or 50,
				posXScale = btn.frame and btn.frame.Position.X.Scale or 0.5,
				posXOffset = btn.frame and btn.frame.Position.X.Offset or (-210 + ((i - 1) * 60)),
				posYScale = btn.frame and btn.frame.Position.Y.Scale or 0.2,
				posYOffset = btn.frame and btn.frame.Position.Y.Offset or 0
			})
		end
		writefile(fileName, HttpService:JSONEncode(saveData))
	end
end

local loadedData = nil
if readfile and isfile and isfile(fileName) then
	pcall(function()
		loadedData = HttpService:JSONDecode(readfile(fileName))
	end)
end

if loadedData then
	isLocked = loadedData.isLocked or false
	menuWidth = loadedData.menuWidth or 240
	menuHeight = loadedData.menuHeight or 360
	if loadedData.buttons then
		for _, savedBtn in ipairs(loadedData.buttons) do
			for _, btn in ipairs(buttonsData) do
				if btn.id == savedBtn.id then
					btn.enabled = savedBtn.enabled
					btn.size = savedBtn.size or 50
					btn.pos = UDim2.new(savedBtn.posXScale, savedBtn.posXOffset, savedBtn.posYScale, savedBtn.posYOffset)
				end
			end
		end
	end
end

