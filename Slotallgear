local function findTool(searchList, excludeList)
	local char = player.Character or player.CharacterAdded:Wait()
	local currentBackpack = player:WaitForChild("Backpack")

	local function checkName(name)
		name = string.lower(name)
		if excludeList then
			for _, exc in ipairs(excludeList) do if string.find(name, exc) then return false end end
		end
		for _, src in ipairs(searchList) do if string.find(name, src) then return true end end
		return false
	end
	for _, v in pairs(currentBackpack:GetChildren()) do if checkName(v.Name) then return v end end
	for _, v in pairs(char:GetChildren()) do if v:IsA("Tool") and checkName(v.Name) then return v end end
	return nil
end

local function applySingleButtonSize(data, newSize)
	data.size = math.clamp(newSize, 20, 150)
	if data.frame then
		data.frame.Size = UDim2.new(0, data.size, 0, data.size)
		local btnText = data.frame:FindFirstChildOfClass("TextButton")
		if btnText then
			local calculatedFontSize = math.clamp(math.floor(data.size * 0.32), 8, 40)
			btnText.TextSize = (string.len(btnText.Text) > 2) and (calculatedFontSize - 2) or calculatedFontSize
		end
	end
	saveConfig()
end

