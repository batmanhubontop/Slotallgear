local function monitorCharacterEquip()
	local function setupChar(char)
		char.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				local isPaintball = string.find(string.lower(child.Name), "paintball") or string.find(string.lower(child.Name), "paint ball")
				if not isPaintball and pbToggleState.isToggled and pbToggleState.stopFunction then
					pbToggleState.stopFunction()
				end
			end
		end)
	end

	if player.Character then
		setupChar(player.Character)
	end
	player.CharacterAdded:Connect(setupChar)
end
