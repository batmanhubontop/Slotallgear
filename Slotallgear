		else
			toggleItemBtn.Text = data.name .. ": OFF"
			toggleItemBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
			isToggled = false
			actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		saveConfig()
	end)

	applySingleButtonSize(data, data.size)
end
