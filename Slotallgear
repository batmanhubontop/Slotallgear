	local dragging, dragStartPos, startPos

	local function startDragging(input)
		if not isLocked and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = true
			dragStartPos = input.Position
			startPos = actionFrame.Position
		end
	end

	actionBtn.InputBegan:Connect(startDragging)
	actionFrame.InputBegan:Connect(startDragging)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStartPos
			local viewportSize = workspace.CurrentCamera.ViewportSize
			local newX = startPos.X.Scale * viewportSize.X + startPos.X.Offset + delta.X
			local newY = startPos.Y.Scale * viewportSize.Y + startPos.Y.Offset + delta.Y
			local clampedX = math.clamp(newX, 0, viewportSize.X - actionFrame.AbsoluteSize.X)
			local clampedY = math.clamp(newY, 0, viewportSize.Y - actionFrame.AbsoluteSize.Y)
			actionFrame.Position = UDim2.new(0, clampedX, 0, clampedY)
		end
	end)

	local isToggled = false
	local isCooldownDisplaying = false

	local function triggerAction()
		if not data.enabled then return end

		if data.cooldown and data.cooldown > 0 and not isCooldownDisplaying then
			isCooldownDisplaying = true
			task.spawn(function()
				local timeLeft = data.cooldown
				while timeLeft > 0 do
					actionBtn.Text = tostring(timeLeft)
					task.wait(1)
					timeLeft = timeLeft - 1
				end
				actionBtn.Text = data.id
				applySingleButtonSize(data, data.size)
				isCooldownDisplaying = false
			end)
		end

		local char = player.Character or player.CharacterAdded:Wait()
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
		local currentBackpack = player:WaitForChild("Backpack")
		if not humanoid then return end

		-- 🆕 เพิ่มการเช็ค customType = "equip_only" (สวมใส่โดยไม่Activate)
		if data.customType == "equip_only" then
			local item = findTool(data.search, data.exclude)
			if item and currentBackpack then
				if item.Parent == currentBackpack then 
					humanoid:EquipTool(item) 
				end
			end
		elseif data.customType == "potion_reset" then
			local item = findTool(data.search, data.exclude)
			if item and currentBackpack then
				if item.Parent == currentBackpack then 
					humanoid:EquipTool(item) 
					task.wait(0.05) 
				end
				item:Activate()
			end

			if humanoid and hrp then
				humanoid.BreakJointsOnDeath = true
				humanoid.PlatformStand = true
				humanoid:ChangeState(Enum.HumanoidStateType.Physics)
				hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				hrp.AssemblyLinearVelocity = Vector3.new(0, 1000000, 0)
			end
		elseif data.customType == "sentry_combo" then
			local normalSentry = findTool({"sentry", "turret", "ป้อม"}, {"candy"})
			local candySentry = findTool({"candy sentry", "candy"}, nil)

			if normalSentry then
				if normalSentry.Parent == currentBackpack then humanoid:EquipTool(normalSentry) task.wait(0.12) end
				normalSentry:Activate()
				task.wait(0.2)
			end

			if candySentry then
				if candySentry.Parent == currentBackpack then humanoid:EquipTool(candySentry) task.wait(0.12) end
				candySentry:Activate()
			end
		elseif data.auto then
			isToggled = not isToggled
			actionBtn.TextColor3 = isToggled and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(255, 255, 255)
			
			pbToggleState.isToggled = isToggled
			pbToggleState.stopFunction = function()
				isToggled = false
				actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				pbToggleState.isToggled = false
			end

			task.spawn(function()
				while isToggled and data.enabled do
					local item = findTool(data.search, data.exclude)
					local activeChar = player.Character
					local activeHumanoid = activeChar and activeChar:FindFirstChildOfClass("Humanoid")
					local activeBackpack = player:FindFirstChild("Backpack")

					if item and activeHumanoid then
						if activeBackpack and item.Parent == activeBackpack then 
							activeHumanoid:EquipTool(item) 
							task.wait(0.05) 
						end
						item:Activate()
					end
					task.wait(0.01)
				end
				if pbToggleState.stopFunction then
					pbToggleState.isToggled = false
				end
			end)
		else
			local item = findTool(data.search, data.exclude)
			if item then
				if item.Parent == currentBackpack then humanoid:EquipTool(item) task.wait(0.1) end
				item:Activate()
			end
		end
	end

